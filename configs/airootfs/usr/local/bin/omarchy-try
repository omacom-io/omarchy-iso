#!/bin/bash
#
# Try Omarchy: bring up the real desktop from the live ISO without touching a
# disk. Every package it needs is already on the medium in the offline mirror,
# so this installs them into the live overlay (RAM), starts a session for a
# throwaway user, and returns when that user chooses "Install Omarchy" — at
# which point the caller shows the greeter again and the ordinary configurator
# takes over. The installer path is not involved at any point.
#
# Exits 0 when the session ended and the greeter should redraw. Exits 1, having
# already printed why, when the session could not start. Never touches a
# block device.
#
# The optional argument prefixes every path the script touches; tests use it
# to run against a sandbox with mount/pacman/systemctl/useradd stubbed out.

set -uo pipefail

root=${1:-}
try_user=try
try_packages=$root/usr/share/omarchy-iso/try-packages
hooks_dir=$root/etc/pacman.d/hooks
cowspace=$root/run/archiso/cowspace
meminfo=$root/proc/meminfo
sudoers=$root/etc/sudoers.d/$try_user
home=$root/home/$try_user
min_mem_kib=$((4 * 1024 * 1024))

# The session runs as a transient systemd unit — not through SDDM. SDDM claims
# VT1, which is where the configurator that launched us lives; starting it
# deallocates that VT and kills the greeter we mean to return to, and stopping
# it leaves VT1 blank. A logind session on its own VT leaves the configurator
# running on VT1 the whole time, so ending the session drops us straight back
# to the greeter this script was called from.
session_unit=omarchy-try-session
session_vt=7

# Boot-image hooks that must not fire in a live root with no ESP and no btrfs.
# Same names the orchestrator masks around pacstrap (DEFERRED_BOOT_HOOKS in
# orchestrator/phases_impl.py); a /dev/null symlink in the local hook dir
# overrides the package's own hook (pacman.conf(5), HookDir).
deferred_boot_hooks=(
  60-mkinitcpio-remove.hook
  60-limine-mkinitcpio-remove-pre.hook
  80-limine-efi-deploy.hook
  90-limine-mkinitcpio-remove-post.hook
  90-mkinitcpio-install.hook
)

# omarchy depends on these for the installed system. The live overlay has
# nowhere to deploy a bootloader or take a snapshot, so satisfy the dependency
# without installing them (and without their hooks).
assume_installed=(limine limine-mkinitcpio-hook limine-snapper-sync snapper)

say() { printf '%s\n' "$*"; }
refuse() { printf 'Try Omarchy: %s\n' "$*" >&2; exit 1; }

mem_kib=$(awk '/^MemTotal:/ { print $2 }' "$meminfo" 2>/dev/null)
(( ${mem_kib:-0} >= min_mem_kib )) ||
  refuse "needs at least 4 GiB of memory to run the desktop from the USB stick; this machine has $(( ${mem_kib:-0} / 1024 )) MiB."
[[ -s $try_packages ]] || refuse "this medium carries no try package list."

# The installer's prefetch is reading the whole mirror largest-first; stop it
# so the session has the memory and the medium's bandwidth.
[[ -n ${OMARCHY_PREFETCH_PID:-} ]] && kill "$OMARCHY_PREFETCH_PID" 2>/dev/null

mapfile -t packages < <(awk '{ print $1 }' "$try_packages")

# archiso's overlay upper is a tmpfs sized by cow_spacesize, 256M by default;
# the try set needs about 1.2 GiB. tmpfs resizes live.
mount -o remount,size=50% "$cowspace" || refuse "could not grow the live overlay."

mkdir -p "$hooks_dir"
for hook in "${deferred_boot_hooks[@]}"; do
  ln -sfn /dev/null "$hooks_dir/$hook"
done

assume=()
for pkg in "${assume_installed[@]}"; do
  assume+=(--assume-installed "$pkg")
done

# -Sy, not -S: mkarchiso empties /var/lib/pacman/sync when it builds the live
# root, so the [offline] database has to be read off the medium first. The
# live pacman.conf carries only [offline] (a file:// path), so this touches no
# network and cannot mix in newer packages than the mirror was built from.
say "Installing the Omarchy desktop from the USB stick. Nothing is written to your disk."
pacman -Sy --needed --noconfirm "${assume[@]}" "${packages[@]}" ||
  refuse "installing the desktop packages failed; see above."

# --- Everything below can undo itself. -----------------------------------

session_network() {
  systemctl stop iwd.service systemd-networkd.service systemd-networkd.socket
  systemctl start NetworkManager.service
}

# The installer expects the environment it booted into (tzupdate and the
# mirror sanity checks run against networkd), so put it back on the way out.
installer_network() {
  systemctl stop NetworkManager.service
  systemctl start systemd-networkd.socket systemd-networkd.service iwd.service
}

# Undo in reverse regardless of how we leave.
cleanup() {
  systemctl stop "$session_unit.service" 2>/dev/null
  installer_network
}

session_network
trap cleanup EXIT

if ! id "$try_user" &>/dev/null; then
  useradd -m -G wheel,video,input,audio -s /bin/bash "$try_user" || refuse "could not create the try user."
  passwd -d "$try_user" >/dev/null
fi
mkdir -p "${sudoers%/*}"
printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$try_user" >"$sudoers"
chmod 440 "$sudoers"

# useradd seeded ~/.config from /etc/skel (omarchy-settings ships it in the
# live root already). Add only what a try session needs on top.
mkdir -p "$home/.config/hypr"
cat >>"$home/.config/hypr/bindings.lua" <<'LUA'

-- Try Omarchy: end this session and start the installer.
o.bind("SUPER + SHIFT + I", "Install Omarchy", "omarchy-try-install")
LUA
cat >>"$home/.config/hypr/autostart.lua" <<'LUA'

-- Try Omarchy: one notification saying what this session is.
o.launch_on_start("omarchy-try-welcome")
LUA
id "$try_user" &>/dev/null && chown -R "$try_user:$try_user" "$home"

runuser -u "$try_user" -- env HOME="$home" OMARCHY_THEME_HEADLESS=1 \
  /usr/share/omarchy/bin/omarchy-theme-set "Tokyo Night" ||
  say "Try Omarchy: theme setup failed; continuing with defaults."
runuser -u "$try_user" -- env HOME="$home" xdg-user-dirs-update 2>/dev/null || true

# Start the desktop as the try user in its own logind session on a dedicated
# VT. PAMName=login gives it a real seat (uwsm and Hyprland need one); the unit
# name is fixed so omarchy-try-install can stop it by name from inside the
# session. The session file is the same one SDDM would have launched.
systemctl reset-failed "$session_unit.service" 2>/dev/null
systemd-run --unit="$session_unit" --collect --quiet \
  --uid="$try_user" --gid="$try_user" \
  -p PAMName=login -p TTYPath="/dev/tty$session_vt" \
  -p TTYReset=yes -p TTYVHangup=yes -p TTYVTDisallocate=yes \
  -p StandardInput=tty -p StandardOutput=journal -p StandardError=journal \
  -p WorkingDirectory="/home/$try_user" \
  -E XDG_SESSION_TYPE=wayland -E XDG_SESSION_CLASS=user \
  /usr/bin/uwsm start -g -1 -e -D Hyprland hyprland.desktop ||
  refuse "could not start the desktop session."

# Bring the session's VT to the foreground once its compositor is up, and tell a
# serial console (the QEMU harness) the same moment. Bounded so a machine where
# the compositor never comes up still falls through to the cleanup below rather
# than hanging on the greeter. Skipped in the test sandbox (no real session).
if [[ -z $root ]]; then
  uid=$(id -u "$try_user" 2>/dev/null || echo 1000)
  for _ in $(seq 1 60); do
    [[ -d /run/user/$uid/hypr ]] && break
    systemctl is-active --quiet "$session_unit.service" || break
    sleep 1
  done
  if [[ -d /run/user/$uid/hypr ]]; then
    chvt "$session_vt" 2>/dev/null
    echo OMARCHY_TRY_SESSION_UP >/dev/ttyS0 2>/dev/null
  fi
fi

# The session lives as long as its unit; omarchy-try-install stops it.
while systemctl is-active --quiet "$session_unit.service"; do
  sleep 2
done

# The compositor let go of its VT; put the greeter back in front. cleanup (the
# EXIT trap) restores the installer's network and stops any lingering unit.
chvt 1 2>/dev/null

exit 0
